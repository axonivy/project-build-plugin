pipeline {
  agent any

  options {
    buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '20'))
  }

  parameters {
    string(name: 'version', description: 'Version to release.')
    string(name: 'engineSource', defaultValue: 'https://product.ivyteam.io', description: 'Engine page url.')
  }

  stages {
    stage('Validate preparations') {
      steps {
        script {
          assertReleaseBranch()
          assertReleaseVersionFormat()
          assertReleaseVersionMatchesProjectVersion()
          assertUnpublished()
          currentBuild.description = params.version
        }
      }
    }

    stage('Build') {
      steps {
        script {
          docker.build('maven').inside {
            def publishingUri = "https://nexus.axonivy.com/#browse/browse:maven-releases"
            def targetBranch = "${env.BRANCH_NAME}-${env.BUILD_NUMBER}"
            sh "git config --global user.name 'ivy-team'"
            sh "git config --global user.email 'info@ivyteam.ch'"
            sh "git checkout -b ${targetBranch}"
            sh "git tag -l | xargs git tag -d"
            
            setVersion(params.version)
            sh "git add . ;git commit -m 'update versions for release ${params.version}'"
            sh "git tag \"v${params.version}\" -a -m \"Official release ${params.version}\""

            setupGPGEnvironment()
            withCredentials([string(credentialsId: 'gpg.password', variable: 'GPG_PWD')]) {
              def args = "-PcentralDeploy " +
                "-Divy.engine.list.url=${params.engineSource} " +
                "-Dgpg.project-build.password='${env.GPG_PWD}' " +
                "-Dgithub.site.skip=false ";
              maven cmd: 'clean deploy site ' + args
            }
            currentBuild.description = "<a href='${publishingUri}'>${params.version}</a>"

            withEnv(['GIT_SSH_COMMAND=ssh -o StrictHostKeyChecking=no']) {
              sshagent(credentials: ['github-axonivy']) {
                def nextVersion = setNextSnapshotVersion(params.version)
                sh "git add . ;git commit -m 'prepare next dev-cycle ${nextVersion}'"
                sh "git push origin --tags"
                sh "git push -u origin ${targetBranch}"
                
                def title = "Prepare for next development cycle (${env.BRANCH_NAME})"
                def message = ":warning: merge this PR only if you verified the artifact is published on [Axon Ivy Nexus](${publishingUri}) and the release is published on GitHub ([Releases](https://github.com/axonivy/project-build-plugin/releases))"
                withCredentials([file(credentialsId: 'github-ivyteam-token-repo-manager', variable: 'tokenFile')]) {
                  sh "gh auth login --with-token < ${tokenFile}"
                  sh "gh pr create --title '${title}' --body '${message}' --head ${targetBranch} --base ${env.BRANCH_NAME}"
                }

                // publish site from 'mvn release' run
                maven cmd: "site site:stage scm-publish:publish-scm -PcentralDeploy"
              }
            }
          }
        }
        archiveArtifacts '**/target/*.jar'
      }
    }
  }
}

def assertReleaseBranch() {
  if (!isReleasingBranch()) {
    error 'Releasing is only possible from a release branch.'
  }
}

def assertReleaseVersionFormat() {
  if (!(params.version ==~ /\d+\.\d+\.\d+/)) {
    error "Expected a valid release version, got '${params.version}'."
  }
}

def assertReleaseVersionMatchesProjectVersion() {
  def sourceVersion
  docker.build('maven').inside {
    sourceVersion = sh(script: "mvn help:evaluate -Dexpression=project.version -q -DforceStdout", returnStdout: true).trim()
  }
  def expectedVersion = sourceVersion.replaceFirst(/-SNAPSHOT$/, '')
  if (params.version != expectedVersion) {
    error "Requested release ${params.version}, but pom.xml resolves to ${expectedVersion}."
  }
}

def assertUnpublished() {
  def versionParts = params.version.tokenize('.')
  if ((versionParts[2] as int) > 0) {
    versionParts[2] = ((versionParts[2] as int) - 1).toString()
    def previousVersion = versionParts.join('.')
    def previousArtifact = mavenArtifactPomStatus(previousVersion)
    if (previousArtifact.statusCode != '200') {
      error "Expected ${previousArtifact.url} to be available (HTTP 200), got HTTP ${previousArtifact.statusCode}."
    }
  }

  def artifact = mavenArtifactPomStatus(params.version)
  if (artifact.statusCode != '404') {
    error "Expected ${artifact.url} to be absent (HTTP 404), got HTTP ${artifact.statusCode}. ${artifact.url} might already be released."
  }
}

def mavenArtifactPomStatus(def version) {
  def url = "https://maven.axonivy.com/com/axonivy/ivy/ci/project-build-plugin/${version}/project-build-plugin-${version}.pom"
  def statusCode = sh(script: "curl --silent --show-error --location --connect-timeout 10 --max-time 60 --output /dev/null --write-out '%{http_code}' '${url}'", returnStdout: true).trim()
  [url: url, statusCode: statusCode]
}

def setNextSnapshotVersion(def version) {
  def versionParts = version.tokenize('.')
  versionParts[2] = "${(versionParts[2] as int) + 1}-SNAPSHOT"
  def nextVersion = versionParts.join('.')
  setVersion(nextVersion)
  return nextVersion
}

def setVersion(def version) {
  sh "mvn org.codehaus.mojo:versions-maven-plugin:2.18.0:set -DnewVersion=${version} -DgenerateBackupPoms=false | grep '\\[.*' "
}

def setupGPGEnvironment() {
  withCredentials([file(credentialsId: 'gpg.keystore', variable: 'GPG_FILE')]) {
    sh "gpg --batch --import ${env.GPG_FILE}"
  }
}
