pipeline {
  agent any

  options {
    buildDiscarder(logRotator(numToKeepStr: '30'))
    disableConcurrentBuilds()
  }

  triggers {
    cron '@midnight'
  }

  stages {
    stage('build') {
      when {
        branch 'master'
      }
      steps {
        script {
          docker.build('maven').inside {
            withCredentials([string(credentialsId: 'sonar.ivyteam.io', variable: 'token')]) {
              sonar projectName: 'project-build-plugin', mvnPhase: 'clean compile'
            }
          }
          recordIssues tools: [mavenConsole()], qualityGates: [[threshold: 1, type: 'TOTAL']]
        }
      }
    }
  }
}
