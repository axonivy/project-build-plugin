pipeline {
  agent any

  options {
    buildDiscarder(logRotator(numToKeepStr: '30'))
    disableConcurrentBuilds()
  }

  triggers {
    cron '@midnight'
  }

  stages {
    stage('build') {
      when {
        branch 'master'
      }
      steps {
        script {
          docker.build('maven').inside {
            sonar projectName: 'project-build-plugin', mvnPhase: 'clean compile'           
          }
        }
      }
    }
  }
}
